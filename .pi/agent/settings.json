{
  "lastChangelogVersion": "0.84.2",
  "theme": "luna",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false,
  "subagents": {
    "defaultModel": "gpt-5.6-terra",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "gpt-5.6-luna",
        "thinking": "low"
      },
      "delegate": {
        "model": "gpt-5.6-luna",
        "thinking": "low"
      },
      "researcher": {
        "model": "gpt-5.6-terra",
        "thinking": "medium"
      },
      "worker": {
        "model": "gpt-5.6-terra",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "gpt-5.6-terra",
        "thinking": "high"
      },
      "oracle": {
        "model": "gpt-5.6-sol",
        "thinking": "high"
      }
    }
  },
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:pi-subagents"
  ]
}