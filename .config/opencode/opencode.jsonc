{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "enabled_providers": [
    "google-vertex",
    "google-vertex-anthropic",
    "github-copilot",
    "lmstudio"
  ],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "mlx-community/gemma-4-12b-it-qat": {
          "name": "Gemma 4 - 12B QAT"
        }
      }
    }
  },
  "model": "github-copilot/gpt-5.6-terra",
  "small_model": "google-vertex-anthropic/claude-haiku-4-5@20251001",
  "lsp": true,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@datadog/opencode-plugin"
  ],
  "agent": {
    "build": {
      "model": "github-copilot/gpt-5.6-terra",
      "variant": "high"
    },
    "plan": {
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "max"
    },
    "general": {
      "model": "github-copilot/gpt-5.6-terra",
      "variant": "medium"
    },
    "explore": {
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "medium"
    },
    "scout": {
      "mode": "subagent",
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "medium"
    }
  },
  "permission": {
    "obsidian_*": "allow"
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "aikido": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@aikidosec/mcp"
      ],
      "enabled": true,
      "environment": {
        "AIKIDO_API_KEY": "{env:AIKIDO_API_KEY}"
      }
    },
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@bitbonsai/mcpvault@latest",
        "/Users/paintmi/work/obsidian"
      ],
      "enabled": true
    }
  }
}
