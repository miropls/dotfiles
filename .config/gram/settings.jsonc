{
  // ── Appearance ───────────────────────────────────────────────────────────
  "auto_signature_help": true,
  "cli_default_open_behavior": "existing_window",
  "completion_menu_item_kind": "symbol",
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "left",
  },
  "soft_wrap": "editor_width",
  "toolbar": {
    "code_actions": true,
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "theme": {
    "mode": "dark",
    "light": "Everforest Light Hard (blur)",
    "dark": "Kanagawa Dragon",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "ui_font_family": "Iosevka Nerd Font Mono",
  "ui_font_weight": 450,
  "ui_font_size": 14,
  "buffer_font_family": "Iosevka Nerd Font Mono",
  "buffer_font_size": 16,
  "buffer_line_height": "standard",
  "buffer_font_weight": 400,
  // "cursor_shape": "block",
  "title_bar": {
    "show_branch_status_icon": true,
    "show_sign_in": true
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_pinned_tabs_in_separate_row": true,
  },
  "project_panel": {
    "dock": "right",
    "entry_spacing": "standard"
  },
  "when_closing_with_no_tabs": "keep_window_open",
  // ── Editor ───────────────────────────────────────────────────────────────
  "format_on_save": "on",
  "autosave": "off",
  "inlay_hints": {
    "enabled": false
  },
  "code_lens": "on",
  // ── Vim ──────────────────────────────────────────────────────────────────
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
  },
  // ── Misc ─────────────────────────────────────────────────────────────────
  "which_key": {
    "enabled": true,
    "delay_ms": 400
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "react-typescript-snippets": true,
  },
  "terminal": {
    "copy_on_select": true,
  },
  "use_smartcase_search": true,
}
