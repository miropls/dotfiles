{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "aikido": {
      "command": "npx",
      "args": [
        "-y",
        "@aikidosec/mcp"
      ],
      "env": {
        "AIKIDO_API_KEY": "${AIKIDO_API_KEY}"
      }
    },
    "obsidian": {
      "command": "npx",
      "args": [
        "-y",
        "@bitbonsai/mcpvault@latest",
        "/Users/paintmi/work/obsidian"
      ]
    }
  }
}
